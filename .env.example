# Telegram bot token from BotFather.
BOT_TOKEN=your_telegram_bot_token_here

# Optional Genius token for lyrics links.
GENIUS_TOKEN=your_genius_token_here

# SQLite database path — kept for the one-time migration script only (v3.1.0+).
DATABASE_PATH=data/music_bot.db

# PostgreSQL connection string (v3.1.0+) — required for the bot to start.
DATABASE_URL=postgresql://music_user:changeme@postgres:5432/music_bot

# PostgreSQL service credentials — used by docker-compose to spin up the DB.
POSTGRES_USER=music_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=music_bot

# Search and pagination settings.
MAX_SEARCH_RESULTS=30
RESULTS_PER_PAGE=5
HISTORY_LIMIT=10
MAX_HISTORY_PER_USER=100

# Logging settings.
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/bot.log
# LOG_FORMAT=json  # Uncomment for structured JSON logs (default: text)
ERROR_HISTORY_LIMIT=10

# Telegram user ID for admin-only commands: /errors, /clear_errors, /health.
ADMIN_ID=your_telegram_user_id
ADMIN_CONFIG_PATH=config/admins.json

# Spotify is optional. If credentials are missing or SPOTIFY_ENABLED=false,
# the bot continues working with Deezer only.
SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_MARKET=NO
SPOTIFY_FORBIDDEN_COOLDOWN_SECONDS=3600

# Circuit breaker cooldown for network-level outages against Spotify, Deezer,
# or Genius (connection/timeout failures, not 4xx/5xx). Separate from
# SPOTIFY_FORBIDDEN_COOLDOWN_SECONDS above.
EXTERNAL_SERVICE_COOLDOWN_SECONDS=60

# Bot runtime mode (v3.3.0+). Default "polling" — no webhook config needed.
# Set to "webhook" only if all WEBHOOK_* values below are also set.
BOT_MODE=polling

# Required only when BOT_MODE=webhook. See docs/DEPLOYMENT.md for setup.
WEBHOOK_PUBLIC_URL=https://your_public_ip_or_domain:8443
WEBHOOK_SECRET_PATH=your_random_secret_path
WEBHOOK_SECRET_TOKEN=your_random_secret_token
WEBHOOK_CERT_PATH=/app/certs/cert.pem
WEBHOOK_KEY_PATH=/app/certs/key.pem
WEBHOOK_PORT=8443
