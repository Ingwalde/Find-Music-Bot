# Telegram bot token from BotFather.
BOT_TOKEN=your_telegram_bot_token_here

# Optional Genius token for lyrics links.
GENIUS_TOKEN=your_genius_token_here

# Local SQLite database path.
DATABASE_PATH=data/music_bot.db

# Search and pagination settings.
MAX_SEARCH_RESULTS=30
RESULTS_PER_PAGE=5
HISTORY_LIMIT=10
MAX_HISTORY_PER_USER=100

# Logging settings.
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/bot.log
ERROR_HISTORY_LIMIT=10

# Telegram user ID for admin-only commands: /errors, /clear_errors, /health.
ADMIN_ID=your_telegram_user_id

# Spotify is optional. If credentials are missing or SPOTIFY_ENABLED=false,
# the bot continues working with Deezer only.
SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_MARKET=NO
SPOTIFY_FORBIDDEN_COOLDOWN_SECONDS=3600
